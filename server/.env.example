# Port to run the server on
PORT=5000

# MongoDB Connection String (leave blank to run in sandbox in-memory mode)
MONGODB_URI=mongodb://localhost:27017/otp-auth

# Secret key used to sign JWT session tokens
JWT_SECRET=your_jwt_secret_key_goes_here

# Twilio Credentials (leave blank to run in sandbox console-bypass mode)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890
